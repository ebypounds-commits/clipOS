# Production environment — NAMES ONLY (CLIP-094).
#
# Copy to `deploy/.env.production` on the production host and fill values
# from the server secret manager. Never commit the filled file: `.env*` is
# blocked by `scripts/secret_scan.sh` and by `.gitignore`.
#
# Real secret injection is a human gate (see `13_HUMAN_GATES_AND_SECRETS.md`).

# --- images (immutable, tagged by commit SHA) ---
CLIPOS_API_IMAGE=ghcr.io/OWNER/clipos-api@sha256:REPLACE
CLIPOS_WEB_IMAGE=ghcr.io/OWNER/clipos-web@sha256:REPLACE

# --- public surface ---
CLIPOS_DOMAIN=clipos.example.com
CLIPOS_ACME_EMAIL=ops@example.com
PUBLIC_API_URL=https://clipos.example.com/api

# --- postgres ---
POSTGRES_USER=clipos
POSTGRES_PASSWORD=
POSTGRES_DB=clipos
TEMPORAL_DB=temporal
DATABASE_URL=postgresql+psycopg://clipos:@postgres:5432/clipos

# --- redis ---
REDIS_PASSWORD=
CACHE_REDIS_URL=redis://:password@redis:6379/0

# --- object storage ---
MINIO_ROOT_USER=clipos
MINIO_ROOT_PASSWORD=
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=clipos
STORAGE_REGION=us-east-1

# --- workflow ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=clipos

# --- Jev decision service ---
JEV_BASE_URL=
JEV_API_KEY=
