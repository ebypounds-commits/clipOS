# Staging environment — NAMES ONLY (CLIP-094).
#
# Staging credentials are deliberately DIFFERENT from production and from
# dev. They still must not be committed: copy this file to
# `deploy/.env.staging` on the staging host.
#
# Note: the dev stack uses `clipos_dev` / `clipos_dev_local_only`. Those
# strings must never appear in staging or production — the topology check
# enforces that (invariant H2).

# --- images (immutable, tagged by commit SHA) ---
CLIPOS_API_IMAGE=ghcr.io/OWNER/clipos-api@sha256:REPLACE
CLIPOS_WEB_IMAGE=ghcr.io/OWNER/clipos-web@sha256:REPLACE

# --- public surface ---
CLIPOS_DOMAIN=staging.clipos.example.com
CLIPOS_ACME_EMAIL=
PUBLIC_API_URL=http://staging.clipos.example.com:8080/api

# --- postgres ---
POSTGRES_USER=clipos_staging
POSTGRES_PASSWORD=
POSTGRES_DB=clipos_staging
TEMPORAL_DB=temporal_staging
DATABASE_URL=postgresql+psycopg://clipos_staging:@postgres:5432/clipos_staging

# --- redis ---
REDIS_PASSWORD=
CACHE_REDIS_URL=redis://:password@redis:6379/0

# --- object storage ---
MINIO_ROOT_USER=clipos_staging
MINIO_ROOT_PASSWORD=
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=clipos-staging
STORAGE_REGION=us-east-1

# --- workflow ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=clipos-staging

# --- Jev decision service ---
JEV_BASE_URL=
JEV_API_KEY=
