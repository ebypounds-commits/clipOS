{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipos.local/schemas/codex_completion_report.schema.json",
  "title": "ClipOS Codex Completion Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id",
    "status",
    "branch",
    "worktree",
    "summary",
    "files_changed",
    "tests",
    "commit_shas",
    "working_tree_clean",
    "blockers"
  ],
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "BLOCKED",
        "FAILED_RETRYABLE"
      ]
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "contracts_changed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "security_rights_budget_impact": {
      "type": "string",
      "default": "none"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "commit_shas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "working_tree_clean": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
